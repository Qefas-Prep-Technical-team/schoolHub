  exitNotes       String?
  academicSession String?
  academicTerm    String?
  academicLevel   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([schoolId])
  @@index([status])
  @@map("student_enrollments")
}

model Assignment {
  id               String                 @id @default(uuid())
  title            String
  instructions     String?
  dueDate          DateTime?
  totalMarks       Float                  @default(100)
  status           SubjectPaperStatus     @default(DRAFT)
  schoolId         String
  teacherId        String
  classId          String
  subjectId        String
  attachmentUrl    String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  departmentId     String?
  referenceUrl     String?
  videoUrl         String?
  scoreReleaseDate DateTime?
  questions        AssignmentQuestion[]
  submissions      AssignmentSubmission[]
  department       Department?            @relation(fields: [departmentId], references: [id])

  @@index([schoolId])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
  @@index([departmentId])
  @@map("assignments")
}

model AssignmentQuestion {
  id            String             @id @default(uuid())
  assignmentId  String
  type          QuestionType
  question      String
  marks         Float              @default(1)
  order         Int                @default(0)
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  correctAnswer String?
  explanation   String?
  rubric        String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  answers       AssignmentAnswer[]
  assignment    Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("assignment_questions")
}

model AssignmentSubmission {
  id           String                     @id @default(uuid())
  assignmentId String
  studentId    String
  status       AssignmentSubmissionStatus @default(PENDING)
  score        Float?
  feedback     String?
  fileUrl      String?
  fileName     String?
  submittedAt  DateTime?
  gradedAt     DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  answers      AssignmentAnswer[]
  assignment   Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model AssignmentAnswer {
  id             String               @id @default(uuid())
  submissionId   String
  questionId     String
  answer         String?
  score          Float                @default(0)
  isCorrect      Boolean              @default(false)
  teacherComment String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  question       AssignmentQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submission     AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([questionId])
  @@map("assignment_answers")
}

model FileRecord {
  id           String   @id @default(uuid())
  fileName     String
  fileUrl      String   @unique
  fileSize     Float
  mimeType     String?
  uploaderId   String
  uploaderType String
  schoolId     String
  createdAt    DateTime @default(now())
  school       School   @relation(fields: [schoolId], references: [id])

  @@map("file_records")
}

