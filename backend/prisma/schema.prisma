generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model School {
  id                       String               @id @default(uuid())
  name                     String
  subdomain                String?              @unique
  tenantId                 String               @unique
  schoolCode               String               @unique
  address                  String?
  phone                    String?
  schoolEmail              String?
  motto                    String?
  logo                     String?
  foundedYear              Int?
  principal                String?
  schoolType               String?
  website                  String?
  description              String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  bannerImage              String?
  favicon                  String?
  mapLocation              String?
  operatingHours           String?
  socialLinks              Json?
  isTrialActive            Boolean              @default(false)
  lastPaymentDate          DateTime?
  paystackCustomerCode     String?
  plan                     String               @default("FREE")
  subscriptionEnd          DateTime?
  subscriptionStatus       String               @default("INACTIVE")
  trialEndsAt              DateTime?
  trialPlan                String?
  trialUsed                Boolean              @default(false)
  accountName              String?
  accountNumber            String?
  bankName                 String?
  paystackSubaccountCode   String?
  percentageCharge         Float?               @default(0)
  paystackSubaccountStatus String               @default("pending")
  planId                   String?
  subscriptionPlanId       String?
  maxClassesOverride       Int?
  maxExamsOverride         Int?
  maxStorageGbOverride     Float?
  maxStudentsOverride      Int?
  billingCycle             String               @default("monthly")
  profileCompleted         Boolean              @default(false)
  registrationSource       String?              @default("STANDARD")
  admins                   SchoolAdmin[]
  classes                  Class[]
  exams                    Exam[]               @relation("SchoolContext")
  subjects                 Subject[]
  teachers                 Teacher[]
  students                 Student[]
  grades                   Grade[]
  primaryTeachers          Teacher[]            @relation("PrimarySchool")
  currentTeachers          Teacher[]            @relation("CurrentSchool")
  activeTeachers           Teacher[]            @relation("ActiveSchool")
  originalStudents         Student[]            @relation("OriginalSchool")
  subscriptionPlan         SubscriptionPlan?    @relation(fields: [subscriptionPlanId], references: [id])
  linkRequests             LinkRequest[]        @relation("SchoolContext")
  requesterLinkRequests    LinkRequest[]        @relation("RequesterSchool")
  targetLinkRequests       LinkRequest[]        @relation("TargetSchool")
  relationshipLinks        RelationshipLink[]
  schoolSubscriptions      SchoolSubscription[]
  teacherSubjects          TeacherSubject[]
  sessions                 Session[]
  transactions             Transaction[]
  settings                 SchoolSetting?
  transactionHistory       TransactionHistory[]
  settlementAccounts       SettlementAccount[]
  emailLogs                EmailLog[]
  payments                 Payment[]
  subjectExamPapers        SubjectExamPaper[]
  quizzes                  Quiz[]
}

model SchoolSetting {
  id                           String   @id @default(uuid())
  schoolId                     String   @unique
  showComingSoon               Boolean  @default(false)
  themeColor                   String   @default("#3670e2")
  defaultSession               String?
  defaultTerm                  String?
  updatedAt                    DateTime @updatedAt
  allowTeacherDigitalSignature Boolean  @default(false)
  enableEmailNotifications     Boolean  @default(true)
  enableMaintenanceMode        Boolean  @default(false)
  enablePushNotifications      Boolean  @default(true)
  lockSettings                 Boolean  @default(false)

  school School @relation(fields: [schoolId], references: [id])
}

model SchoolAdmin {
  id        String    @id @default(uuid())
  adminId   String
  schoolId  String
  role      AdminRole
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  admin  Admin  @relation(fields: [adminId], references: [id])
  school School @relation(fields: [schoolId], references: [id])

  @@unique([adminId, schoolId])
  @@map("school_admins")
}

model Admin {
  id                      String            @id @default(uuid())
  name                    String
  email                   String            @unique
  password                String?
  role                    UserRole
  adminCode               String            @unique
  googleId                String?           @unique
  authProvider            String            @default("EMAIL")
  tenantId                String            @default("default-tenant-id")
  verified                Boolean           @default(false)
  status                  String            @default("PENDING")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  gender                  Gender?
  isTrialActive           Boolean           @default(false)
  lastPaymentDate         DateTime?
  plan                    String            @default("FREE")
  subscriptionEnd         DateTime?
  subscriptionStatus      String            @default("INACTIVE")
  trialEndsAt             DateTime?
  trialPlan               String?
  trialUsed               Boolean           @default(false)
  emailVerificationCode   String?
  emailVerificationExpiry DateTime?
  pendingEmail            String?
  bannerImage             String?
  profileImage            String?
  paystackCustomerCode    String?
  paystackSubaccountCode  String?
  planId                  String?
  billingCycle            String            @default("monthly")
  subscriptionPlanId      String?
  schoolAdmins            SchoolAdmin[]
  acceptedTerms           Boolean           @default(false)
  termsAcceptedAt         DateTime?
  subscriptionPlan        SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  requestedLinkRequests   LinkRequest[]     @relation("RequestedByAdmin")
  approvedLinkRequests    LinkRequest[]     @relation("ApprovedByAdmin")
  reportedBehaviourAlerts BehaviourAlert[]  @relation("Reporter")
}

model Teacher {
  id                      String            @id @default(uuid())
  name                    String
  email                   String?           @unique
  password                String?
  isClaimed               Boolean           @default(false)
  invitationToken         String?           @unique
  role                    UserRole
  tenantId                String            @default("default-tenant-id")
  teacherCode             String            @unique
  googleId                String?           @unique
  authProvider            String            @default("EMAIL")
  subject                 String?
  department              String?
  primarySchoolId         String?
  activeSchoolId          String?
  verified                Boolean           @default(false)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  gender                  Gender?
  isTrialActive           Boolean           @default(false)
  lastPaymentDate         DateTime?
  plan                    String            @default("FREE")
  subscriptionEnd         DateTime?
  subscriptionStatus      String            @default("INACTIVE")
  trialEndsAt             DateTime?
  trialPlan               String?
  trialUsed               Boolean           @default(false)
  emailVerificationCode   String?
  emailVerificationExpiry DateTime?
  pendingEmail            String?
  bannerImage             String?
  profileImage            String?
  paystackCustomerCode    String?
  paystackSubaccountCode  String?
  planId                  String?
  billingCycle            String            @default("monthly")
  currentSchoolId         String?
  schoolId                String?
  settings                Json?             @default("{}")
  subscriptionPlanId      String?
  isIndependent           Boolean           @default(false)
  acceptedTerms           Boolean           @default(false)
  termsAcceptedAt         DateTime?
  subscriptionPlan        SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])

  school                School?            @relation(fields: [schoolId], references: [id])
  currentSchool         School?            @relation("CurrentSchool", fields: [currentSchoolId], references: [id])
  primarySchool         School?            @relation("PrimarySchool", fields: [primarySchoolId], references: [id])
  activeSchool          School?            @relation("ActiveSchool", fields: [activeSchoolId], references: [id])
  exams                 Exam[]
  classTeachers         ClassTeacher[]
  grades                Grade[]
  teacherSubjects       TeacherSubject[]
  subjects              Subject[]
  subjectExamPapers     SubjectExamPaper[]
  requestedLinkRequests LinkRequest[]      @relation("RequesterTeacher")
  targetLinkRequests    LinkRequest[]      @relation("TargetTeacher")
  userSubscriptions     UserSubscription[] @relation("TeacherSubscription")
  timetablePeriods      TimetablePeriod[]
}

model Student {
  id                      String            @id @default(uuid())
  name                    String
  email                   String            @unique
  password                String?
  studentCode             String            @unique
  googleId                String?           @unique
  authProvider            String            @default("EMAIL")
  tenantId                String            @default("default-tenant-id")
  gradeLevel              String?
  dateOfBirth             DateTime?
  role                    UserRole
  schoolId                String?
  originalSchoolId        String?
  verified                Boolean           @default(false)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  gender                  Gender?
  isTrialActive           Boolean           @default(false)
  lastPaymentDate         DateTime?
  plan                    String            @default("FREE")
  subscriptionEnd         DateTime?
  subscriptionStatus      String            @default("INACTIVE")
  trialEndsAt             DateTime?
  trialPlan               String?
  trialUsed               Boolean           @default(false)
  departmentId            String?
  termAverage             Float?
  emailVerificationCode   String?
  emailVerificationExpiry DateTime?
  pendingEmail            String?
  bannerImage             String?
  profileImage            String?
  paystackCustomerCode    String?
  paystackSubaccountCode  String?
  planId                  String?
  billingCycle            String            @default("monthly")
  subscriptionPlanId      String?
  acceptedTerms           Boolean           @default(false)
  termsAcceptedAt         DateTime?
  subscriptionPlan        SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])

  school                School?            @relation(fields: [schoolId], references: [id])
  originalSchool        School?            @relation("OriginalSchool", fields: [originalSchoolId], references: [id])
  classes               ClassEnrollment[]
  examAttempts          ExamAttempt[]
  grades                Grade[]
  parentLinks           ParentChildLink[]
  requestedLinkRequests LinkRequest[]      @relation("RequesterStudent")
  targetLinkRequests    LinkRequest[]      @relation("TargetStudent")
  attendances           Attendance[]
  behaviourAlerts       BehaviourAlert[]
  userSubscriptions     UserSubscription[] @relation("StudentSubscription")
  department            Department?        @relation(fields: [departmentId], references: [id])
  payments              Payment[]
}

model Parent {
  id                      String            @id @default(uuid())
  fullName                String
  email                   String            @unique
  password                String?
  parentCode              String            @unique
  phone                   String?
  googleId                String?           @unique
  authProvider            String            @default("EMAIL")
  role                    UserRole
  tenantId                String            @default("default-tenant-id")
  verified                Boolean           @default(false)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  gender                  Gender?
  isTrialActive           Boolean           @default(false)
  lastPaymentDate         DateTime?
  plan                    String            @default("FREE")
  subscriptionEnd         DateTime?
  subscriptionStatus      String            @default("INACTIVE")
  trialEndsAt             DateTime?
  trialPlan               String?
  trialUsed               Boolean           @default(false)
  emailVerificationCode   String?
  emailVerificationExpiry DateTime?
  pendingEmail            String?
  bannerImage             String?
  profileImage            String?
  paystackCustomerCode    String?
  paystackSubaccountCode  String?
  planId                  String?
  billingCycle            String            @default("monthly")
  subscriptionPlanId      String?
  acceptedTerms           Boolean           @default(false)
  termsAcceptedAt         DateTime?
  subscriptionPlan        SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])

  children              ParentChildLink[]
  requestedLinkRequests LinkRequest[]      @relation("RequesterParent")
  targetLinkRequests    LinkRequest[]      @relation("TargetParent")
  userSubscriptions     UserSubscription[] @relation("ParentSubscription")
  payments              Payment[]

  @@map("parents")
}

model ParentChildLink {
  id           String   @id @default(uuid())
  parentId     String
  studentId    String
  studentCode  String
  relationship String   @default("parent")
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
  @@index([studentCode])
  @@map("parent_child_links")
}

model Class {
  id            String          @id @default(uuid())
  name          String
  section       String?
  schoolId      String?
  classCode     String          @unique
  scope         ClassScope
  status        ClassStatus     @default(PENDING)
  createdById   String?
  createdByType LinkEntityType?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  school            School?            @relation(fields: [schoolId], references: [id])
  enrollments       ClassEnrollment[]
  exams             Exam[]
  teachers          ClassTeacher[]
  grades            Grade[]
  attendances       Attendance[]
  behaviourAlerts   BehaviourAlert[]
  linkRequests      LinkRequest[]
  relationshipLinks RelationshipLink[]
  subjects          ClassSubject[]
  departments       ClassDepartment[]
  quizzes           Quiz[]
  timetablePeriods  TimetablePeriod[]

  @@unique([schoolId, name, section])
  @@map("classes")
}

model ClassEnrollment {
  id         String   @id @default(uuid())
  classId    String
  studentId  String
  enrolledAt DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
  @@map("class_enrollments")
}

model VerificationCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  userType  UserRole
  createdAt DateTime @default(now())
  expiresAt DateTime
  used      Boolean  @default(false)

  @@index([email])
  @@index([code])
  @@map("verification_codes")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  userType  UserRole
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, userType])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String
  userType  UserRole
  verified  Boolean  @default(false)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
  @@index([expiresAt])
  @@map("password_resets")
}

model Grade {
  id                   String        @id @default(uuid())
  studentId            String
  schoolId             String
  teacherId            String?
  classId              String?
  subject              String
  assessmentType       String?
  score                Float
  maxMarks             Float
  remarks              String?
  examId               String?
  examAttemptId        String?
  subjectExamAttemptId String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  category             GradeCategory @default(EXAM)
  sessionId            String?
  status               GradeStatus   @default(DRAFT)
  subjectPaperId       String?
  term                 Term?
  weight               Float         @default(1.0)

  student            Student             @relation(fields: [studentId], references: [id])
  school             School              @relation(fields: [schoolId], references: [id])
  teacher            Teacher?            @relation(fields: [teacherId], references: [id])
  class              Class?              @relation(fields: [classId], references: [id])
  exam               Exam?               @relation(fields: [examId], references: [id])
  subjectPaper       SubjectExamPaper?   @relation(fields: [subjectPaperId], references: [id])
  session            Session?            @relation(fields: [sessionId], references: [id])
  examAttempt        ExamAttempt?        @relation(fields: [examAttemptId], references: [id])
  subjectExamAttempt SubjectExamAttempt? @relation(fields: [subjectExamAttemptId], references: [id])

  @@unique([studentId, examId, subjectPaperId])
  @@index([studentId])
  @@map("grades")
}

model LinkRequest {
  id                 String            @id @default(uuid())
  linkType           LinkType
  status             LinkRequestStatus @default(PENDING)
  requesterType      LinkEntityType
  requesterId        String
  requesterCode      String
  targetType         LinkEntityType
  targetId           String?
  targetCode         String
  requestedByAdminId String?
  approvedByAdminId  String?
  schoolId           String?
  classId            String?
  note               String?
  rejectionReason    String?
  expiresAt          DateTime?
  requesterSchoolId  String?
  targetSchoolId     String?
  requesterTeacherId String?
  targetTeacherId    String?
  requesterStudentId String?
  targetStudentId    String?
  requesterParentId  String?
  targetParentId     String?
  relationshipLinkId String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  respondedAt        DateTime?

  requestedByAdmin Admin?  @relation("RequestedByAdmin", fields: [requestedByAdminId], references: [id])
  approvedByAdmin  Admin?  @relation("ApprovedByAdmin", fields: [approvedByAdminId], references: [id])
  school           School? @relation("SchoolContext", fields: [schoolId], references: [id])
  class            Class?  @relation(fields: [classId], references: [id])

  requesterSchool  School?  @relation("RequesterSchool", fields: [requesterSchoolId], references: [id])
  targetSchool     School?  @relation("TargetSchool", fields: [targetSchoolId], references: [id])
  requesterTeacher Teacher? @relation("RequesterTeacher", fields: [requesterTeacherId], references: [id])
  targetTeacher    Teacher? @relation("TargetTeacher", fields: [targetTeacherId], references: [id])
  requesterStudent Student? @relation("RequesterStudent", fields: [requesterStudentId], references: [id])
  targetStudent    Student? @relation("TargetStudent", fields: [targetStudentId], references: [id])
  requesterParent  Parent?  @relation("RequesterParent", fields: [requesterParentId], references: [id])
  targetParent     Parent?  @relation("TargetParent", fields: [targetParentId], references: [id])

  relationshipLink RelationshipLink? @relation(fields: [relationshipLinkId], references: [id])
  notifications    Notification[]

  @@index([requesterType, requesterId])
  @@index([targetType, targetCode])
  @@index([targetType, targetId])
  @@index([status])
  @@index([linkType])
  @@index([schoolId])
  @@index([targetSchoolId])
  @@index([classId])
  @@index([requesterTeacherId])
  @@index([targetTeacherId])
  @@index([requesterStudentId])
  @@index([targetStudentId])
  @@index([requesterParentId])
  @@index([targetParentId])
  @@index([createdAt])
  @@index([classId], map: "link_requests_class_id_idx")
  @@index([createdAt], map: "link_requests_created_at_idx")
  @@index([requesterParentId], map: "link_requests_req_parent_idx")
  @@index([requesterStudentId], map: "link_requests_req_student_idx")
  @@index([requesterTeacherId], map: "link_requests_req_teacher_idx")
  @@index([schoolId], map: "link_requests_school_id_idx")
  @@index([targetParentId], map: "link_requests_target_parent_idx")
  @@index([targetSchoolId], map: "link_requests_target_school_id_idx")
  @@index([targetStudentId], map: "link_requests_target_student_idx")
  @@index([targetTeacherId], map: "link_requests_target_teacher_idx")
  @@map("link_requests")
}

model RelationshipLink {
  id              String         @id @default(uuid())
  linkType        LinkType
  status          LinkStatus     @default(ACTIVE)
  leftEntityType  LinkEntityType
  leftEntityId    String
  leftCode        String
  rightEntityType LinkEntityType
  rightEntityId   String
  rightCode       String
  schoolId        String?
  classId         String?
  startedAt       DateTime       @default(now())
  endedAt         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  school              School?             @relation(fields: [schoolId], references: [id])
  class               Class?              @relation(fields: [classId], references: [id])
  approvedFromRequest LinkRequest?
  audits              RelationshipAudit[]

  @@unique([linkType, leftEntityId, rightEntityId])
  @@index([leftEntityType, leftEntityId, status])
  @@index([rightEntityType, rightEntityId, status])
  @@index([linkType, status])
  @@map("relationship_links")
}

model RelationshipAudit {
  id                 String   @id @default(uuid())
  relationshipLinkId String
  action             String
  actorAdminId       String?
  note               String?
  createdAt          DateTime @default(now())

  relationshipLink RelationshipLink @relation(fields: [relationshipLinkId], references: [id])

  @@index([relationshipLinkId])
  @@map("relationship_audits")
}

model Notification {
  id            String             @id @default(uuid())
  recipientType LinkEntityType
  recipientId   String
  senderType    LinkEntityType?
  senderId      String?
  type          NotificationType
  title         String
  message       String
  linkRequestId String?
  link          String?
  status        NotificationStatus @default(UNREAD)
  meta          Json?
  createdAt     DateTime           @default(now())
  readAt        DateTime?

  linkRequest LinkRequest? @relation(fields: [linkRequestId], references: [id])

  @@index([recipientType, recipientId, status])
  @@index([recipientId])
  @@map("notifications")
}

model Subject {
  id          String                 @id @default(uuid())
  name        String
  code        String
  description String?
  schoolId    String?
  teacherId   String?
  scope       AcademicOwnershipScope
  isArchived  Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  school            School?             @relation(fields: [schoolId], references: [id])
  teacher           Teacher?            @relation(fields: [teacherId], references: [id])
  departments       DepartmentSubject[]
  classes           ClassSubject[]
  teacherSubjects   TeacherSubject[]
  exams             Exam[]
  subjectExamPapers SubjectExamPaper[]
  timetablePeriods  TimetablePeriod[]
  quizzes           Quiz[]

  @@unique([schoolId, code])
  @@map("subjects")
}

model Department {
  id          String                 @id @default(uuid())
  name        String
  code        String                 @unique
  description String?
  schoolId    String?
  teacherId   String?
  scope       AcademicOwnershipScope
  isArchived  Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  students Student[]
  subjects DepartmentSubject[]
  classes  ClassDepartment[]
  exams    ExamDepartment[]
  quizzes  Quiz[]

  @@map("departments")
}

model DepartmentSubject {
  id           String   @id @default(uuid())
  departmentId String
  subjectId    String
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id])
  subject    Subject    @relation(fields: [subjectId], references: [id])

  @@unique([departmentId, subjectId])
  @@map("department_subjects")
}

model ClassSubject {
  id        String   @id @default(uuid())
  classId   String
  subjectId String
  createdAt DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

model ClassDepartment {
  id           String   @id @default(uuid())
  classId      String
  departmentId String
  createdAt    DateTime @default(now())

  class      Class      @relation(fields: [classId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([classId, departmentId])
  @@map("class_departments")
}

model Quiz {
  id              String                 @id @default(uuid())
  title           String
  description     String?
  scope           AssessmentScope
  status          AssessmentStatus       @default(DRAFT)
  creationMode    AssessmentCreationMode @default(MANUAL)
  schoolId        String?
  departmentId    String?
  classId         String?
  subjectId       String?
  durationMinutes Int?
  totalMarks      Float?                 @default(0)
  aiPrompt        String?
  instructions    String?
  generatedMeta   Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  class      Class?         @relation(fields: [classId], references: [id])
  subject    Subject?       @relation(fields: [subjectId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])
  school     School?        @relation(fields: [schoolId], references: [id])
  questions  QuizQuestion[]

  @@map("quizzes")
}

model QuizSubject {
  id        String   @id @default(uuid())
  quizId    String
  subjectId String
  createdAt DateTime @default(now())

  @@unique([quizId, subjectId])
  @@map("quiz_subjects")
}

model QuizQuestion {
  id            String       @id @default(uuid())
  quizId        String
  type          QuestionType
  question      String
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  correctAnswer String
  marks         Float        @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  imageLabels   String[]     @default([])
  images        String[]     @default([])

  quiz Quiz @relation(fields: [quizId], references: [id])

  @@map("quiz_questions")
}

model Exam {
  id                   String                 @id @default(uuid())
  title                String
  description          String?
  scope                AssessmentScope
  status               AssessmentStatus       @default(DRAFT)
  creationMode         AssessmentCreationMode @default(MANUAL)
  category             ExamCategory           @default(EXAM)
  mode                 ExamMode               @default(SINGLE_SUBJECT)
  schoolId             String?
  classId              String?
  sessionId            String?
  term                 Term?
  teacherId            String?
  durationMinutes      Int?
  totalMarks           Float?                 @default(0)
  allowImmediateResult Boolean                @default(true)
  resultReleaseAt      DateTime?
  startDate            DateTime?
  aiPrompt             String?
  instructions         String?
  generatedMeta        Json?
  validatedAt          DateTime?
  validatedById        String?
  publishedAt          DateTime?
  publishedById        String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  subjectId            String?
  endDate              DateTime?
  shuffleQuestions     Boolean                @default(false)

  school            School?            @relation("SchoolContext", fields: [schoolId], references: [id])
  class             Class?             @relation(fields: [classId], references: [id])
  teacher           Teacher?           @relation(fields: [teacherId], references: [id])
  subject           Subject?           @relation(fields: [subjectId], references: [id])
  session           Session?           @relation(fields: [sessionId], references: [id])
  examAttempts      ExamAttempt[]
  grades            Grade[]
  departments       ExamDepartment[]
  subjectExamPapers ExamSubjectPaper[]

  @@map("exams")
}

model ExamSubject {
  id        String   @id @default(uuid())
  examId    String
  subjectId String
  createdAt DateTime @default(now())

  @@unique([examId, subjectId])
  @@map("exam_subjects")
}

model SubjectExamPaper {
  id              String             @id @default(uuid())
  subjectId       String?
  schoolId        String?
  teacherId       String?
  title           String?
  instructions    String?
  durationMinutes Int?
  totalMarks      Float              @default(0)
  status          SubjectPaperStatus @default(DRAFT)
  validatedAt     DateTime?
  validatedById   String?
  publishedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  readingContent  String?
  passMark        Float              @default(40)
  weight          Float              @default(1)
  imageLabels     String[]           @default([])
  images          String[]           @default([])
  grades          Grade[]

  subject      Subject?              @relation(fields: [subjectId], references: [id])
  teacher      Teacher?              @relation(fields: [teacherId], references: [id])
  school       School?               @relation(fields: [schoolId], references: [id])
  examAttempts SubjectExamAttempt[]
  exams        ExamSubjectPaper[]
  questions    SubjectExamQuestion[]

  @@index([subjectId])
  @@index([schoolId, status])
  @@map("subject_exam_papers")
}

model ExamSubjectPaper {
  id             String   @id @default(uuid())
  examId         String
  subjectPaperId String
  createdAt      DateTime @default(now())

  exam         Exam             @relation(fields: [examId], references: [id])
  subjectPaper SubjectExamPaper @relation(fields: [subjectPaperId], references: [id])

  @@unique([examId, subjectPaperId])
  @@map("exam_subject_papers")
}

model SubjectExamQuestion {
  id             String         @id @default(uuid())
  subjectPaperId String
  type           QuestionType
  source         QuestionSource @default(MANUAL)
  question       String
  optionA        String?
  optionB        String?
  optionC        String?
  optionD        String?
  correctAnswer  String
  explanation    String?
  marks          Float          @default(1)
  order          Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  imageLabels    String[]       @default([])
  images         String[]       @default([])

  subjectPaper SubjectExamPaper    @relation(fields: [subjectPaperId], references: [id])
  answers      SubjectExamAnswer[]

  @@index([subjectPaperId])
  @@map("subject_exam_questions")
}

model TeacherSubject {
  id        String   @id @default(uuid())
  teacherId String
  subjectId String
  schoolId  String?
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  school  School? @relation(fields: [schoolId], references: [id])

  @@unique([teacherId, subjectId, schoolId])
  @@map("teacher_subjects")
}

model Session {
  id          String   @id @default(uuid())
  name        String
  schoolId    String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(false)
  isClosed    Boolean  @default(false)
  currentTerm Term     @default(FIRST)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id])
  grades Grade[]
  exams  Exam[]

  @@unique([schoolId, name])
  @@map("sessions")
}

model ExamAttempt {
  id                  String               @id @default(uuid())
  examId              String
  studentId           String
  startedAt           DateTime             @default(now())
  submittedAt         DateTime?
  expiresAt           DateTime?
  status              ExamAttemptStatus    @default(IN_PROGRESS)
  totalScore          Float                @default(0)
  totalMarks          Float                @default(0)
  isSubmitted         Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  subjectExamAttempts SubjectExamAttempt[]
  grades              Grade[]

  exam    Exam    @relation(fields: [examId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId])
  @@map("exam_attempts")
}

model SubjectExamAttempt {
  id             String    @id @default(uuid())
  examAttemptId  String
  subjectPaperId String
  score          Float     @default(0)
  totalMarks     Float     @default(0)
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  weightedScore  Float?

  examAttempt  ExamAttempt         @relation(fields: [examAttemptId], references: [id])
  subjectPaper SubjectExamPaper    @relation(fields: [subjectPaperId], references: [id])
  answers      SubjectExamAnswer[]
  grades       Grade[]

  @@unique([examAttemptId, subjectPaperId])
  @@map("subject_exam_attempts")
}

model SubjectExamAnswer {
  id                   String    @id @default(uuid())
  subjectExamAttemptId String
  questionId           String
  answer               String
  isCorrect            Boolean?
  scoreAwarded         Float?
  requiresManualReview Boolean   @default(false)
  manuallyReviewed     Boolean   @default(false)
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNote           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  subjectExamAttempt SubjectExamAttempt  @relation(fields: [subjectExamAttemptId], references: [id])
  question           SubjectExamQuestion @relation(fields: [questionId], references: [id])

  @@unique([subjectExamAttemptId, questionId])
  @@index([subjectExamAttemptId])
  @@map("subject_exam_answers")
}

model ExamDepartment {
  id           String   @id @default(uuid())
  examId       String
  departmentId String
  createdAt    DateTime @default(now())

  exam       Exam       @relation(fields: [examId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([examId, departmentId])
  @@map("exam_departments")
}

model Attendance {
  id        String   @id @default(uuid())
  classId   String
  studentId String
  date      DateTime @db.Date
  status    String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class   @relation(fields: [classId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId, date])
  @@map("attendances")
}

model TimetablePeriod {
  id        String   @id @default(uuid())
  classId   String
  day       String
  startTime String
  endTime   String
  subjectId String
  teacherId String
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  @@index([classId, day])
  @@map("timetable_periods")
}

model ClassTeacher {
  id        String   @id @default(uuid())
  classId   String
  teacherId String
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([classId, teacherId])
  @@map("class_teachers")
}

model BehaviourAlert {
  id           String        @id @default(uuid())
  type         BehaviourType @default(WARNING)
  title        String
  description  String?
  studentId    String
  reportedById String
  classId      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student  Student @relation(fields: [studentId], references: [id])
  reporter Admin   @relation("Reporter", fields: [reportedById], references: [id])
  class    Class   @relation(fields: [classId], references: [id])

  @@map("behaviour_alerts")
}

model Transaction {
  id                 Int       @id @default(autoincrement())
  schoolId           String?
  planId             String?
  amount             Float
  currency           String    @default("GHS")
  status             String    @default("PENDING")
  reference          String    @unique
  authorizationToken String?
  paymentMethod      String?
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  billingCycle       String?
  plan               String?
  userId             String?
  userType           UserRole?

  school School? @relation(fields: [schoolId], references: [id])

  @@map("transactions")
}

model FileMetric {
  id        String   @id
  fileName  String
  fileSize  BigInt
  fileType  String
  schoolId  String?
  studentId String?
  teacherId String?
  parentId  String?
  createdAt DateTime @default(now())
}

model Tenant {
  id        String   @id
  name      String
  schoolId  String   @unique
  createdAt DateTime @default(now())
}

model Payment {
  id                  String    @id @default(uuid())
  paymentReference    String    @unique
  studentId           String
  schoolId            String
  parentId            String
  amount              Float
  term                String
  session             String
  paymentType         String
  status              String    @default("PENDING")
  paymentMethod       String?
  paidAt              DateTime?
  updatedAt           DateTime  @updatedAt
  settlementAccountId String?
  createdAt           DateTime  @default(now())

  parent             Parent?              @relation(fields: [parentId], references: [id])
  student            Student              @relation(fields: [studentId], references: [id])
  school             School               @relation(fields: [schoolId], references: [id])
  transactionHistory TransactionHistory[]

  @@map("payments")
}

model TransactionHistory {
  id                   String    @id @default(uuid())
  schoolId             String
  paymentId            String?
  transactionReference String    @unique
  amount               Float
  gatewayResponse      Json?
  channel              String?
  currency             String    @default("NGN")
  status               String
  paidAt               DateTime?
  createdAt            DateTime  @default(now())
  settlementAccountId  String?

  school            School             @relation(fields: [schoolId], references: [id])
  payment           Payment?           @relation(fields: [paymentId], references: [id])
  settlementAccount SettlementAccount? @relation(fields: [settlementAccountId], references: [id])

  @@map("transaction_histories")
}

model SettlementAccount {
  id                       String   @id @default(uuid())
  schoolId                 String
  paystackSubaccountCode   String?
  paystackSubaccountStatus String   @default("pending")
  accountName              String?
  accountNumber            String?
  bankName                 String?
  bankCode                 String?
  isVerified               Boolean  @default(false)
  percentageCharge         Float?   @default(0)
  isDefault                Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  school               School               @relation(fields: [schoolId], references: [id])
  transactionHistories TransactionHistory[]

  @@map("settlement_accounts")
}

model SubscriptionPlan {
  id           String    @id @default(uuid())
  name         String
  maxStudents  Int       @default(0)
  maxExams     Int       @default(0)
  maxClasses   Int       @default(0)
  maxStorageGb Float     @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  badgeLabel   String?
  buttonText   String    @default("Get Started")
  category     String    @default("INSTITUTION")
  description  String?
  features     String[]
  isActive     Boolean   @default(true)
  maxAiUsage   Int       @default(0)
  maxParents   Int       @default(0)
  maxTeachers  Int       @default(0)
  monthlyPrice Float     @default(0)
  sortOrder    Int       @default(0)
  trialDays    Int       @default(0)
  type         String    @default("PAID")
  yearlyPrice  Float     @default(0)
  planScope    PlanScope @default(SCHOOL)
  hasTrial     Boolean   @default(false)
  isPopular    Boolean   @default(false)

  featureAccess         PlanFeatureAccess[]
  schools               School[]
  admins                Admin[]
  teachers              Teacher[]
  students              Student[]
  parents               Parent[]
  schoolSubscriptions   SchoolSubscription[]
  userSubscriptions     UserSubscription[]
  subscriptionHistories SubscriptionHistory[]

  @@unique([category, type])
  @@map("subscription_plans")
}

model PlanFeatureAccess {
  id         String   @id @default(uuid())
  planId     String
  featureId  String
  enabled    Boolean  @default(false)
  limitValue Int?
  meta       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  plan    SubscriptionPlan @relation(fields: [planId], references: [id])
  feature PlatformFeature  @relation(fields: [featureId], references: [id])

  @@unique([planId, featureId])
  @@map("plan_feature_access")
}

model SchoolSubscription {
  id                 String             @id @default(uuid())
  schoolId           String             @unique
  subscriptionPlanId String
  subscriptionType   SubscriptionType   @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  startedAt          DateTime           @default(now())
  expiresAt          DateTime?
  autoRenew          Boolean            @default(true)
  assignedBy         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  school           School           @relation(fields: [schoolId], references: [id])
  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  @@map("school_subscriptions")
}

model UserSubscription {
  id                 String             @id @default(uuid())
  userId             String             @unique
  userType           UserRole
  subscriptionPlanId String
  subscriptionType   SubscriptionType   @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  startedAt          DateTime           @default(now())
  expiresAt          DateTime?
  autoRenew          Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])
  teacher          Teacher?         @relation("TeacherSubscription", fields: [userId], references: [id], map: "user_subscriptions_teacher_fkey")
  student          Student?         @relation("StudentSubscription", fields: [userId], references: [id], map: "user_subscriptions_student_fkey")
  parent           Parent?          @relation("ParentSubscription", fields: [userId], references: [id], map: "user_subscriptions_parent_fkey")

  @@map("user_subscriptions")
}

model SubscriptionHistory {
  id                 String             @id @default(uuid())
  schoolId           String?
  userId             String?
  userType           UserRole?
  subscriptionPlanId String
  subscriptionType   SubscriptionType
  status             SubscriptionStatus
  startedAt          DateTime
  expiresAt          DateTime?
  endedAt            DateTime?
  amountPaid         Float?
  paymentReference   String?
  activatedBy        String?
  note               String?
  createdAt          DateTime           @default(now())

  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  @@index([schoolId])
  @@index([userId])
  @@map("subscription_histories")
}

model SupportTicket {
  id          String          @id @default(uuid())
  subject     String
  description String
  status      SupportStatus   @default(OPEN)
  priority    SupportPriority @default(MEDIUM)
  category    String?
  userType    String
  userId      String
  userName    String
  userEmail   String
  schoolName  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  messages SupportMessage[]

  @@index([userId])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(uuid())
  ticketId   String
  content    String
  senderId   String
  senderName String
  senderRole String
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("support_messages")
}

model PlatformStaff {
  id            String       @id @default(uuid())
  fullName      String
  email         String       @unique
  password      String?
  role          PlatformRole
  isActive      Boolean      @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  inviteExpires DateTime?
  inviteToken   String?      @unique

  logs PlatformActivityLog[]

  @@map("platform_staff")
}

model PlatformActivityLog {
  id         String   @id @default(uuid())
  staffId    String
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  staff PlatformStaff @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@map("platform_activity_logs")
}

model PlatformFeature {
  id             String   @id @default(uuid())
  featureKey     String   @unique
  name           String
  label          String
  description    String?
  studentEnabled Boolean  @default(true)
  teacherEnabled Boolean  @default(true)
  parentEnabled  Boolean  @default(true)
  adminEnabled   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  planAccess PlanFeatureAccess[]

  @@map("platform_features")
}

model PlatformSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model EmailLog {
  id             String   @id @default(uuid())
  schoolId       String?
  recipientEmail String?
  to             String?
  subject        String
  body           String
  type           String
  status         String   @default("SENT")
  error          String?
  createdAt      DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id])

  @@map("email_logs")
}

model SchemeOfWork {
  id          String   @id @default(uuid())
  title       String
  description String?
  tenantId    String
  schoolId    String?
  subjectId   String
  classId     String
  term        Int
  week        Int
  topic       String
  objectives  String?
  activities  String?
  resources   String?
  status      String   @default("DRAFT")
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("scheme_of_works")
}

