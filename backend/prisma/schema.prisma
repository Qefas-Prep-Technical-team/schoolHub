// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// generator erd {
//   provider = "prisma-erd-generator"
//   output   = "./ERD.svg"
// }

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ENUMS MUST BE DEFINED BEFORE THEY ARE USED 
enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ClassScope {
  PERSONAL
  SCHOOL
}

enum ClassStatus {
  PENDING
  ACTIVE
  REJECTED
  ARCHIVED
}

enum AssessmentScope {
  SCHOOL
  DEPARTMENT
  CLASS
  PERSONAL
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  SCORED
  EXPIRED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum AssessmentCreationMode {
  MANUAL
  AI
  HYBRID
}

enum QuestionSource {
  MANUAL
  AI
}

enum ExamMode {
  SINGLE_SUBJECT
  COMBINED
}

enum SubjectPaperStatus {
  DRAFT
  REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum ExamCategory {
  EXAM
  QUIZ
}

enum AdminRole {
  SUPER_ADMIN
  SCHOOL_OWNER
  PRINCIPAL
  REGISTRAR
  ACCOUNTANT
  SUPPORT
}

enum LinkEntityType {
  SCHOOL
  ADMIN
  TEACHER
  STUDENT
  PARENT
  CLASS
}

enum LinkType {
  SCHOOL_ADMIN
  SCHOOL_TEACHER
  SCHOOL_STUDENT
  TEACHER_STUDENT
  PARENT_STUDENT
  TEACHER_CLASS
  STUDENT_CLASS
}

enum LinkRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum LinkStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum AcademicOwnershipScope {
  PERSONAL
  SCHOOL
}

model School {
  id          String  @id @default(uuid())
  name        String
  subdomain   String? @unique
  schoolEmail String?
  tenantId    String  @unique
  schoolCode  String  @unique
  address     String?
  phone       String?

  grades Grade[]
  admins SchoolAdmin[]

  students    Student[]
  classes     Class[]
  departments Department[]
  subjects    Subject[]

  requesterLinkRequests LinkRequest[]      @relation("requesterSchool")
  targetLinkRequests    LinkRequest[]      @relation("targetSchool")
  relationshipLinks     RelationshipLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quizzes   Quiz[]
  exams     Exam[]

  teachers        Teacher[]        @relation("SchoolToTeacher")
  currentTeachers Teacher[]        @relation("TeacherCurrentSchool")
  sessions        Session[]
  teacherSubjects TeacherSubject[]
}

model SchoolAdmin {
  id       String    @id @default(uuid())
  adminId  String
  schoolId String
  role     AdminRole
  active   Boolean   @default(true) // Track if admin still works at the school

  admin  Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, schoolId])
  @@map("school_admins")
}

// Add to your existing schema
model Admin {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  password        String?
  role            UserRole
  adminCode       String   @unique
  googleId        String?  @unique
  authProvider    String   @default("EMAIL")
  tenantIds       String[] @default(["default-tenant-id"])
  defaultTenantId String   @default("default-tenant-id")
  verified        Boolean  @default(false)
  status          String   @default("PENDING")

  schoolAdmins SchoolAdmin[]

  requestedLinkRequests LinkRequest[]       @relation("requesterAdmin")
  approvedLinkRequests  LinkRequest[]       @relation("approverAdmin")
  relationshipAudits    RelationshipAudit[] @relation("AdminRelationshipAudits")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gender    Gender?
}

model Teacher {
  id              String  @id @default(uuid())
  name            String
  email           String? @unique
  password        String?
  isClaimed       Boolean @default(false)
  invitationToken String? @unique

  grades          Grade[]
  role            UserRole
  tenantIds       String[] @default(["default-tenant-id"])
  defaultTenantId String   @default("default-tenant-id")
  teacherCode     String   @unique
  googleId        String?  @unique
  authProvider    String   @default("EMAIL")
  subject         String?
  department      String?

  schoolId        String?
  currentSchoolId String?

  school        School? @relation("SchoolToTeacher", fields: [schoolId], references: [id])
  currentSchool School? @relation("TeacherCurrentSchool", fields: [currentSchoolId], references: [id])

  classes  Class[] @relation("AssignedTeacherClasses")
  verified Boolean @default(false)

  outgoingLinkRequests LinkRequest[] @relation("requesterTeacher")
  incomingLinkRequests LinkRequest[] @relation("targetTeacher")

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  gender            Gender?
  subjects          Subject[]
  departments       Department[]
  teacherSubjects   TeacherSubject[]
  subjectExamPapers SubjectExamPaper[]
}

model Student {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  password         String?
  studentCode      String            @unique
  googleId         String?           @unique
  authProvider     String            @default("EMAIL")
  tenantIds        String[]          @default(["default-tenant-id"])
  defaultTenantId  String            @default("default-tenant-id")
  gradeLevel       String?
  dateOfBirth      DateTime?
  role             UserRole
  school           School?           @relation(fields: [schoolId], references: [id])
  schoolId         String?
  originalSchoolId String?
  grades           Grade[]
  classes          ClassEnrollment[]
  parentLinks      ParentChildLink[]

  outgoingLinkRequests LinkRequest[] @relation("requesterStudent")
  incomingLinkRequests LinkRequest[] @relation("targetStudent")

  verified     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  gender       Gender?
  examAttempts ExamAttempt[]

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
}

model Parent {
  id              String            @id @default(uuid())
  fullName        String
  email           String            @unique
  password        String?
  parentCode      String            @unique
  phone           String?
  googleId        String?           @unique
  authProvider    String            @default("EMAIL")
  role            UserRole
  tenantIds       String[]          @default(["default-tenant-id"])
  defaultTenantId String            @default("default-tenant-id")
  children        ParentChildLink[]
  verified        Boolean           @default(false)

  outgoingLinkRequests LinkRequest[] @relation("requesterParent")
  incomingLinkRequests LinkRequest[] @relation("targetParent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gender    Gender?

  @@map("parents")
}

model ParentChildLink {
  id        String @id @default(uuid())
  parentId  String
  studentId String

  // ✅ add this
  studentCode String

  relationship String   @default("parent")
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentCode])
  @@map("parent_child_links")
}

model Class {
  id        String      @id @default(uuid())
  name      String
  section   String?
  schoolId  String?
  teacherId String?
  classCode String      @unique
  scope     ClassScope
  status    ClassStatus @default(PENDING)

  createdById   String?
  createdByType LinkEntityType?

  grades Grade[]

  school            School?            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher           Teacher?           @relation("AssignedTeacherClasses", fields: [teacherId], references: [id])
  enrollments       ClassEnrollment[]
  relationshipLinks RelationshipLink[]

  subjects ClassSubject[]
  exams    Exam[]
  quizzes  Quiz[]
  linkRequests LinkRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name, section])
  @@map("classes")
}

model ClassEnrollment {
  id        String @id @default(uuid())
  classId   String
  studentId String

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  enrolledAt DateTime @default(now())

  @@unique([classId, studentId])
  @@map("class_enrollments")
}

model VerificationCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  userType  UserRole // CHANGED: Use UserRole instead of UserType
  createdAt DateTime @default(now())
  expiresAt DateTime
  used      Boolean  @default(false)

  @@index([email])
  @@index([code])
  @@map("verification_codes")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  userType  UserRole // CHANGED: Use UserRole instead of UserType
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, userType])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String
  userType  UserRole
  verified  Boolean  @default(false)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
  @@index([expiresAt])
  @@map("password_resets")
}

model Grade {
  id        String  @id @default(uuid())
  studentId String
  schoolId  String
  teacherId String? // Add this to fix the Teacher error
  classId   String?

  // Relations
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull) // Add this
  class   Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)

  subject        String
  assessmentType String
  score          Float
  maxMarks       Float
  remarks        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("grades")
}

model LinkRequest {
  id String @id @default(uuid())

  linkType      LinkType
  status        LinkRequestStatus @default(PENDING)
  notifications Notification[]
  requesterType LinkEntityType
  requesterId   String
  requesterCode String

  targetType LinkEntityType
  targetId   String?
  targetCode String

  requestedByAdminId String?
  approvedByAdminId  String?

  schoolId String?
  classId  String?

  note            String?
  rejectionReason String?
  expiresAt       DateTime?

  requesterSchoolId  String?
  targetSchoolId     String?
  requesterTeacherId String?
  targetTeacherId    String?
  requesterStudentId String?
  targetStudentId    String?
  requesterParentId  String?
  targetParentId     String?

  relationshipLinkId String? @unique

  requesterAdmin Admin? @relation("requesterAdmin", fields: [requestedByAdminId], references: [id], onDelete: SetNull)
  approverAdmin  Admin? @relation("approverAdmin", fields: [approvedByAdminId], references: [id], onDelete: SetNull)

  requesterSchool  School?  @relation("requesterSchool", fields: [requesterSchoolId], references: [id], onDelete: SetNull)
  targetSchool     School?  @relation("targetSchool", fields: [targetSchoolId], references: [id], onDelete: SetNull)
  requesterTeacher Teacher? @relation("requesterTeacher", fields: [requesterTeacherId], references: [id], onDelete: SetNull)
  targetTeacher    Teacher? @relation("targetTeacher", fields: [targetTeacherId], references: [id], onDelete: SetNull)
  requesterStudent Student? @relation("requesterStudent", fields: [requesterStudentId], references: [id], onDelete: SetNull)
  targetStudent    Student? @relation("targetStudent", fields: [targetStudentId], references: [id], onDelete: SetNull)
  requesterParent  Parent?  @relation("requesterParent", fields: [requesterParentId], references: [id], onDelete: SetNull)
  targetParent     Parent?  @relation("targetParent", fields: [targetParentId], references: [id], onDelete: SetNull)

  relationshipLink RelationshipLink? @relation("RelationshipFromRequest", fields: [relationshipLinkId], references: [id], onDelete: SetNull)
  class            Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  respondedAt DateTime?

  @@index([requesterType, requesterId])
  @@index([targetType, targetCode])
  @@index([status])
  @@index([linkType])
  @@map("link_requests")
}

model RelationshipLink {
  id String @id @default(uuid())

  linkType LinkType
  status   LinkStatus @default(ACTIVE)

  leftEntityType LinkEntityType
  leftEntityId   String
  leftCode       String

  rightEntityType LinkEntityType
  rightEntityId   String
  rightCode       String

  schoolId String?
  classId  String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  class  Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  approvedFromRequest LinkRequest?        @relation("RelationshipFromRequest")
  audits              RelationshipAudit[]

  @@unique([linkType, leftEntityId, rightEntityId])
  @@index([leftEntityType, leftEntityId, status])
  @@index([rightEntityType, rightEntityId, status])
  @@index([linkType, status])
  @@map("relationship_links")
}

model RelationshipAudit {
  id String @id @default(uuid())

  relationshipLinkId String
  action             String
  actorAdminId       String?
  note               String?

  relationshipLink RelationshipLink @relation(fields: [relationshipLinkId], references: [id], onDelete: Cascade)
  actorAdmin       Admin?           @relation("AdminRelationshipAudits", fields: [actorAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([relationshipLinkId])
  @@map("relationship_audits")
}

enum NotificationType {
  LINK_REQUEST
  LINK_ACCEPTED
  LINK_REJECTED
  GENERAL
}

enum NotificationStatus {
  UNREAD
  READ
}

model Notification {
  id String @id @default(uuid())

  recipientType LinkEntityType
  recipientId   String

  senderType LinkEntityType?
  senderId   String?

  type    NotificationType
  title   String
  message String

  linkRequestId String?
  linkRequest   LinkRequest? @relation(fields: [linkRequestId], references: [id], onDelete: Cascade)

  link           String?
  status NotificationStatus @default(UNREAD)
  meta   Json?

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([recipientType, recipientId, status])
  @@index([recipientId])
  @@map("notifications")
}

model Subject {
  id          String                 @id @default(uuid())
  name        String
  code        String
  description String?
  schoolId    String?
  teacherId   String?
  scope       AcademicOwnershipScope
  isArchived  Boolean                @default(false)

  school          School?             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher         Teacher?            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  departments     DepartmentSubject[]
  classes         ClassSubject[]
  exams           Exam[]
  quizzes         Quiz[]
  examLinks       ExamSubject[]
  quizLinks       QuizSubject[]
  teacherSubjects TeacherSubject[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  subjectExamPapers SubjectExamPaper[]

  @@unique([schoolId, code])
  @@map("subjects")
}

model Department {
  id          String                 @id @default(uuid())
  name        String
  code        String                 @unique
  description String?
  schoolId    String?
  teacherId   String?
  scope       AcademicOwnershipScope
  isArchived  Boolean                @default(false)

  school   School?             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher  Teacher?            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjects DepartmentSubject[]
  exams    Exam[]
  quizzes  Quiz[]
  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model DepartmentSubject {
  id           String @id @default(uuid())
  departmentId String
  subjectId    String

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([departmentId, subjectId])
  @@map("department_subjects")
}

model ClassSubject {
  id        String @id @default(uuid())
  classId   String
  subjectId String

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

model Quiz {
  id           String                 @id @default(uuid())
  title        String
  description  String?
  scope        AssessmentScope
  status       AssessmentStatus       @default(DRAFT)
  creationMode AssessmentCreationMode @default(MANUAL)

  schoolId     String?
  departmentId String?
  classId      String?
  subjectId    String?

  durationMinutes Int?
  totalMarks      Float? @default(0)

  aiPrompt      String?
  instructions  String?
  generatedMeta Json?

  school     School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  class      Class?      @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject    Subject?    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  includedSubjects QuizSubject[]
  questions        QuizQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quizzes")
}

model QuizSubject {
  id        String @id @default(uuid())
  quizId    String
  subjectId String

  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([quizId, subjectId])
  @@map("quiz_subjects")
}

model QuizQuestion {
  id            String       @id @default(uuid())
  quizId        String
  type          QuestionType
  question      String
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  correctAnswer String
  marks         Float        @default(1)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quiz_questions")
}

model Exam {
  id           String                 @id @default(uuid())
  title        String
  description  String?
  scope        AssessmentScope
  status       AssessmentStatus       @default(DRAFT)
  creationMode AssessmentCreationMode @default(MANUAL)
  category     ExamCategory           @default(EXAM)
  mode         ExamMode               @default(SINGLE_SUBJECT)

  schoolId     String?
  departmentId String?
  classId      String?
  sessionId    String?

  durationMinutes Int?
  totalMarks      Float? @default(0)

  allowImmediateResult Boolean   @default(true)
  resultReleaseAt      DateTime?
  startDate            DateTime?

  aiPrompt      String?
  instructions  String?
  generatedMeta Json?

  validatedAt   DateTime?
  validatedById String?
  publishedAt   DateTime?
  publishedById String?

  school     School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  class      Class?      @relation(fields: [classId], references: [id], onDelete: Cascade)
  session    Session?    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  includedSubjects ExamSubject[]
  subjectPapers    SubjectExamPaper[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subject   Subject? @relation(fields: [subjectId], references: [id])
  subjectId String?

  examAttempts ExamAttempt[]

  @@map("exams")
}

model ExamSubject {
  id        String @id @default(uuid())
  examId    String
  subjectId String

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([examId, subjectId])
  @@map("exam_subjects")
}

model SubjectExamPaper {
  id              String             @id @default(uuid())
  examId          String?
  subjectId       String
  teacherId       String?
  title           String?
  instructions    String?
  durationMinutes Int?
  totalMarks      Float              @default(0)
  status          SubjectPaperStatus @default(DRAFT)

  validatedAt   DateTime?
  validatedById String?
  publishedAt   DateTime?

  exam    Exam?    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  questions    SubjectExamQuestion[]
  examAttempts SubjectExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examId, subjectId])
  @@map("subject_exam_papers")
}

model SubjectExamQuestion {
  id             String         @id @default(uuid())
  subjectPaperId String
  type           QuestionType
  source         QuestionSource @default(MANUAL)
  question       String
  optionA        String?
  optionB        String?
  optionC        String?
  optionD        String?
  correctAnswer  String
  explanation    String?
  marks          Float          @default(1)
  order          Int            @default(0)

  subjectPaper SubjectExamPaper    @relation(fields: [subjectPaperId], references: [id], onDelete: Cascade)
  answers      SubjectExamAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subject_exam_questions")
}

model TeacherSubject {
  id        String  @id @default(uuid())
  teacherId String
  subjectId String
  schoolId  String?

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  school  School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId, schoolId])
  @@map("teacher_subjects")
}

model Session {
  id        String   @id @default(uuid())
  name      String
  schoolId  String?
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  isClosed  Boolean  @default(false)

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exams  Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@map("sessions")
}

model ExamAttempt {
  id        String @id @default(uuid())
  examId    String
  studentId String

  startedAt   DateTime          @default(now())
  submittedAt DateTime?
  expiresAt   DateTime?
  status      ExamAttemptStatus @default(IN_PROGRESS)

  totalScore  Float   @default(0)
  totalMarks  Float   @default(0)
  isSubmitted Boolean @default(false)

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  subjectAttempts SubjectExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId])
  @@map("exam_attempts")
}

model SubjectExamAttempt {
  id             String @id @default(uuid())
  examAttemptId  String
  subjectPaperId String

  score       Float     @default(0)
  totalMarks  Float     @default(0)
  submittedAt DateTime?

  examAttempt  ExamAttempt      @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  subjectPaper SubjectExamPaper @relation(fields: [subjectPaperId], references: [id], onDelete: Cascade)

  answers SubjectExamAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examAttemptId, subjectPaperId])
  @@map("subject_exam_attempts")
}

model SubjectExamAnswer {
  id                   String @id @default(uuid())
  subjectExamAttemptId String
  questionId           String

  answer               String
  isCorrect            Boolean?
  scoreAwarded         Float?
  requiresManualReview Boolean   @default(false)
  manuallyReviewed     Boolean   @default(false)
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNote           String?

  subjectExamAttempt SubjectExamAttempt  @relation(fields: [subjectExamAttemptId], references: [id], onDelete: Cascade)
  question           SubjectExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectExamAttemptId, questionId])
  @@map("subject_exam_answers")
}
