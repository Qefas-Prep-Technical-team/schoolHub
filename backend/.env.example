PORT=5000
NODE_ENV=development

# Database Connection (Supabase PostgreSQL via PgBouncer Pooler)
# DATABASE_URL uses pooler port 6543 with pgbouncer=true, pool/connect timeouts, and connection limit.
DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20&connect_timeout=15
# DIRECT_URL connects directly on port 5432 for migrations (bypasses transaction pooler)
DIRECT_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres


# Authentication & JWT Secrets
JWT_SECRET=your-jwt-secret-key
JWT_ACCESS_SECRET=your-jwt-access-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key

# Client App URL
FRONTEND_URL=http://localhost:3000
